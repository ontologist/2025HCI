{
  "mcpServers": {
    "document-loader": {
      "command": "${userHome}/.local/bin/uvx",
      "args": ["awslabs.document-loader-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    },
    "zip-mcp": {
      "command": "npx",
      "args": ["-y", "zip-mcp"],
      "env": {},
      "disabled": false,
      "autoApprove": []
    }
  }
}
